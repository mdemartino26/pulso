# Copiá este archivo como .env.local y completá los valores.
# .env.local está en .gitignore: NUNCA lo subas a GitHub.

# --- Públicas (llegan al navegador; no son secretas) ---
# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Supabase > Project Settings > API Keys > "Publishable key" (sb_publishable_...)
# Es el reemplazo de la antigua "anon key". Lo que protege los datos es RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública de la app (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secretas (solo servidor; nunca con prefijo NEXT_PUBLIC_) ---
# Supabase > Project Settings > API Keys > "Secret key" (sb_secret_...)
# Saltea RLS. Solo la usa src/server/supabase/admin.ts (caché de alimentos y borrar cuenta).
SUPABASE_SECRET_KEY=
# https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
